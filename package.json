{
  "name": "vina",
  "private": false,
  "version": "0.11.0",
  "type": "module",
  "description": "Cognitive Design Engine for Professional Fashion Engineering — Semantic Pattern Editor + XPBD Simulation + Situated AI Copilot",
  "bin": {
    "vina": "./dist-cli/index.js",
    "vina-server": "./dist-server/index.js"
  },
  "scripts": {
    "dev": "vite",
    "dev:server": "npx tsx --watch server/index.ts",
    "cli": "npx tsx cli/index.ts",
    "build": "tsc -b && vite build",
    "build:cli": "tsc -p cli/tsconfig.json",
    "build:server": "tsc -p server/tsconfig.json",
    "build:all": "npm run build && npm run build:server && npm run build:cli",
    "start": "node dist-server/index.js",
    "lint": "eslint .",
    "lint:ui": "node scripts/ui-contract-lint.mjs",
    "lint:contraste": "tsx scripts/contraste-tokens.ts",
    "audit:ui": "node scripts/ui-surface-audit.mjs",
    "audit:capturas": "node scripts/capturas-ui.mjs",
    "preview": "vite preview",
    "prepare": "husky",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "test:e2e": "playwright test",
    "test:e2e:headed": "playwright test --headed",
    "test:e2e:ui": "playwright test --ui",
    "test:e2e:gpu": "playwright test --config playwright.webgpu.config.ts",
    "test:e2e:home": "playwright test --config playwright.home.config.ts",
    "test:e2e:gpu:determinism": "playwright test --config playwright.webgpu.config.ts -g determinism --repeat-each=5",
    "determinism:diff": "tsx scripts/gpu-determinism-diff.ts",
    "bench": "tsx bench/run.ts",
    "bench:matchvertices": "tsx bench/matchVertices.bench.ts",
    "bench:lra": "tsx bench/buildLRAConstraints.bench.ts",
    "home:patron": "tsx scripts/home/dxf-a-svg.mjs",
    "home:paginas": "node scripts/home/paginas.mjs",
    "home:readme": "node scripts/home/readme.mjs",
    "home:activos": "node scripts/home/activos.mjs",
    "avatares": "node scripts/avatares/generar-todas.mjs",
    "avatares:tallas": "node scripts/avatares/tallas.mjs"
  },
  "dependencies": {
    "@dimforge/rapier3d-compat": "^0.19.3",
    "@pixiv/three-vrm": "^3.4.5",
    "@react-three/drei": "^9.117.0",
    "@react-three/fiber": "^8.17.0",
    "@reduxjs/toolkit": "^2.5.1",
    "@tailwindcss/typography": "^0.5.19",
    "cdt2d": "^1.0.0",
    "clean-pslg": "^1.1.2",
    "clipper2-js": "^1.2.4",
    "fast-xml-parser": "^5.4.1",
    "fflate": "^0.8.2",
    "idb": "^8.0.3",
    "lucide-react": "^0.575.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "react-markdown": "^10.1.0",
    "react-redux": "^9.2.0",
    "react-zoom-pan-pinch": "^3.7.0",
    "remark-gfm": "^4.0.1",
    "three": "^0.184.0",
    "three-mesh-bvh": "^0.9.9",
    "ws": "^8.19.0",
    "zod": "^4.3.6"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.13.0",
    "@eslint/js": "^9.17.0",
    "@gltf-transform/core": "^4.5.1",
    "@gltf-transform/extensions": "^4.5.1",
    "@gltf-transform/functions": "^4.5.1",
    "@playwright/test": "^1.58.2",
    "@testing-library/jest-dom": "^6.9.1",
    "@testing-library/react": "^16.3.2",
    "@types/node": "^22.19.11",
    "@types/react": "^18.3.18",
    "@types/react-dom": "^18.3.5",
    "@types/three": "^0.184.1",
    "@types/ws": "^8.18.1",
    "@vitejs/plugin-react": "^4.3.4",
    "@vitest/coverage-v8": "^4.0.18",
    "@webgpu/types": "^0.1.70",
    "eslint": "^9.17.0",
    "eslint-plugin-react-hooks": "^5.0.0",
    "eslint-plugin-react-refresh": "^0.4.16",
    "fake-indexeddb": "^6.2.5",
    "globals": "^15.14.0",
    "husky": "^9.1.7",
    "jsdom": "^28.1.0",
    "lint-staged": "^16.2.7",
    "meshoptimizer": "^1.3.0",
    "puppeteer": "^24.37.5",
    "tsx": "^4.21.0",
    "typescript": "~5.6.2",
    "typescript-eslint": "^8.18.2",
    "vite": "^6.0.5",
    "vite-plugin-node-polyfills": "^0.25.0",
    "vitest": "^4.0.18"
  },
  "license": "MIT",
  "lint-staged": {
    "*.{ts,tsx}": [
      "eslint --max-warnings=0"
    ]
  }
}
