# Husky hooks are run via `sh`; CRLF line endings break the shebang/parser on
# checkout under Windows autocrlf. Force LF so the gate runs everywhere.
.husky/pre-commit text eol=lf

# Frozen DXF garment fixtures: keep bytes identical across platforms (the
# parser tolerates CRLF, but byte-stable fixtures keep hashes/diffs honest).
tests/fixtures/garments/*.dxf text eol=lf

# SSH known_hosts consumed by the deploy runner: a trailing CR on a key line
# breaks host-key verification. Force LF everywhere.
deploy/known_hosts text eol=lf

# Shell scripts run via bash (Git Bash local): a CRLF checkout under Windows
# autocrlf breaks the parser mid-script. Force LF.
scripts/*.sh text eol=lf

# El gate de push corre la suite completa; mismas razones de LF que pre-commit.
.husky/pre-push text eol=lf

# El SVG del hero lo compara byte a byte tests/repo/home-patron.test.ts con la
# salida del generador (LF). Un checkout CRLF lo rompería. Force LF.
home/img/patron.svg text eol=lf

# La home se publica tal cual sale del build (el HTML no se minifica): con
# autocrlf=true un checkout en Windows le metía un CR por línea y el trinquete
# de peso (tests/e2e/home-peso-baseline.json) medía 102 B de más. Force LF.
index.html text eol=lf
app/index.html text eol=lf
home/*.css text eol=lf
home/*.html text eol=lf
home/img/*.svg text eol=lf
public/*.svg text eol=lf
public/*.webmanifest text eol=lf

# vina-mcp y vina-studio se publican en npm desde estas carpetas: un CRLF en el
# shebang de bin/*.mjs rompe `npx vina-studio` en Mac y Linux. Force LF.
mcp/** text eol=lf
studio/** text eol=lf
