node_modules
dist
dist-server
.DS_Store

# Playwright
test-results/
playwright-report/
crates/*/target/

# Coverage
coverage/

# Worktrees

# Tool artifacts
.copyclip/
.playwright-mcp/
copyclip_metrics.jsonl
snapshot-*.md
# Canonical home for ALL test/probe/evidence screenshots — gitignored wholesale.
# Evidence runners and ad-hoc Playwright harnesses write here (e.g.
# screenshots/seam-allowance/). Keep curated DESIGN artifacts in
# design-handoff/ui-screenshots/ (committed); never mix test evidence there.
screenshots/
# Salida de scripts/ui-surface-audit.mjs: capturas + censo crudo de la app viva.
# Es evidencia, no documentación — misma regla que screenshots/. Lo que se
# conserva es docs/reports/2026-08-14-auditoria-ui-deriva-de-diseno.md.
docs/reports/ui-audit-*/
# .claude/ es local (settings.local.json, worktrees) EXCEPTO las skills del
# proyecto: esas son contrato compartido y tienen que viajar con el repo, igual
# que .husky/. Una skill sin versionar es una skill que para las demás sesiones
# no existe — el mismo modo de falla que el hook gitignoreado.
.claude/*
!.claude/skills/
# Ad-hoc scratch: probe screenshots, measurement scripts, demo captures from manual runs.
.tmp/

# Local review artifacts
OpenClo_Review_*.docx
Vina_Review_*.docx
.github/*
!.github/workflows/
!.github/workflows/**
# .husky/_ is auto-generated (self-ignored via .husky/_/.gitignore); user hooks like
# .husky/pre-commit must stay tracked so the gate is shared. Do NOT re-ignore .husky/.
scripts/deploy.sh
tiny-piece.patch
bom-e2e-test.png
test-*.png
pr*.png
docs/specs/APPLICATION-AUDIT-*.md

# CLAUDE/ — local-only context routing layer (per-developer).
# Project canonical lives in CLAUDE.md + docs/reports/.
CLAUDE/

# Local tooling state (per-developer, not project canonical)
.cgcignore
.superpowers/
.worktrees/
entities.json
mempalace.yaml

