#!/bin/sh

# Run TypeScript type checking on entire project
echo "🔍 Running TypeScript type check..."
npx tsc -b --noEmit
if [ $? -ne 0 ]; then
  echo "❌ TypeScript errors found. Fix them before committing."
  exit 1
fi

# Run lint-staged (eslint on staged files)
echo "🔍 Running ESLint on staged files..."
npx lint-staged
if [ $? -ne 0 ]; then
  echo "❌ ESLint errors found. Fix them before committing."
  exit 1
fi

# Contrato de interfaz (trinquete): ~0.9 s, solo falla si un contador SUBE.
# Existe porque la auditoría 2026-08-14 encontró 8 contratos escritos y los 8
# rodeados: la regla sin guardián es una sugerencia.
echo "🔍 Contrato de interfaz..."
node scripts/ui-contract-lint.mjs
if [ $? -ne 0 ]; then
  echo "❌ Un contador del contrato de UI subió. Ver docs/reports/2026-08-14-auditoria-ui-deriva-de-diseno.md"
  exit 1
fi

echo "✅ Pre-commit checks passed!"
